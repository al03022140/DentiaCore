# ─── DentiaCore Server Environment ──────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env files with actual secrets to version control.

# Modo de despliegue (DEPLOYMENT_MODE fase 1 — hoy solo informativo; las
# fases siguientes derivan cookies/storage/URLs de aquí):
#   local = instancia de clínica (launcher/instaladores, LAN, disco local)
#   cloud = instancia operada detrás de proxy HTTPS (Fases 3-5 del roadmap)
DEPLOYMENT_MODE=local
NODE_ENV=development
API_URL=http://localhost:5002
LOG_LEVEL=info
UPLOADS_DIR=uploads

# JWT — Generate a strong random secret (≥64 hex chars):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=dentia-core
# En PRODUCCIÓN (con HTTPS) la cookie de sesión ya es Secure automáticamente
# (se deriva de NODE_ENV). Usa esto solo para forzar Secure también en dev:
COOKIE_SECURE=false

# Solo si el server corre DETRÁS de un reverse-proxy (nginx/Caddy): nº de saltos
# (normalmente 1) para que req.ip lea X-Forwarded-For y el rate limiting por IP
# funcione. Déjalo vacío en despliegue mono-máquina sin proxy.
TRUST_PROXY=

# Audit log tamper-protection (NOM-024). REQUERIDO en producción (≥32 chars).
# El server NO arranca en producción si falta o es débil. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_SECRET=

# Key ring (R-1) — claves retiradas del audit log, separadas por comas.
# Solo VERIFICAN entradas históricas; nunca firman. Rotar la clave:
#   1) añade el valor actual de AUDIT_HMAC_SECRET al final de esta lista,
#   2) genera un AUDIT_HMAC_SECRET nuevo, 3) reinicia. Sin migraciones.
# ⚠️ NUNCA elimines una clave de esta lista mientras existan entradas
#    firmadas con ella: verify reportará `unknown_key` (esperado, no corrupción).
AUDIT_HMAC_RETIRED_SECRETS=

# Google OAuth (server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5002/api/google/oauth2callback

# Optional encryption key for sensitive data at rest
ENCRYPTION_KEY=

PORT=5002
HOST=0.0.0.0
# En PRODUCCIÓN: habilita autenticación en MongoDB y úsala aquí; no expongas el
# puerto 27017 a la red. Ej.:
#   mongodb://usuario:password@127.0.0.1:27017/DentiaCore?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/DentiaCore
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5002
